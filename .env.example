# Iyed AI – server-side configuration (never prefix these with VITE_).
# Local dev: copy to .env.local. Production: Vercel → Project → Settings → Environment Variables.

# --- LLM provider -----------------------------------------------------------
# anthropic | groq | openai | gemini | openrouter | mistral | openai-compatible
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional for anthropic (default claude-opus-5-5) and groq (default llama-3.3-70b-versatile).
# Required for openai, gemini, openrouter, mistral and openai-compatible.
LLM_MODEL=
# Only for openai-compatible (self-hosted vLLM, Ollama gateway, LiteLLM…), e.g. https://llm.example.com/v1
LLM_BASE_URL=

# Without any key the assistant still works in "knowledge-base mode":
# answers are built from the verified portfolio content, without an LLM.

# --- Abuse protection --------------------------------------------------------
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=60
# Global cap on LLM calls per day (protects your API budget)
LLM_DAILY_CAP=1500
# Recommended in production so limits are shared across serverless instances
# (free tier at upstash.com). Without it, counters are per instance (in memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Extra origins allowed to call /api/chat (comma-separated). Same-origin is always allowed.
ALLOWED_ORIGINS=
